+fn foamProcessBlob(pos : vec2f, t : f32) -> f32 {
+  // Learned from the supplied foam snippet: scaled coordinates, orthogonal sine/cosine perturbation,
+  // blob/noise inversion, amplification, power sharpening and clamp.
+  var foamUv = pos * 0.42;
+  let fx = pos.y * 0.08;
+  let fy = pos.x * 0.08;
+  foamUv.x += cos(fx * 20.0 + t * 1.0) * 0.17;
+  foamUv.y += sin(fy * 20.0 + t * 1.0) * 0.17;
+  let blob = clamp(0.62 * fbm(foamUv * 2.1) + 0.38 * vnoise(foamUv * 5.7), 0.0, 1.0);
+  var foam = 1.0 - blob;
+  foam = clamp(foam * 1.2, 0.0, 1.0);
+  foam = pow(foam, 4.0);
+  foam = clamp(foam * 1.5, 0.0, 1.0);
+  return foam;
+}
+fn coastalPulseFoam(pos : vec2f, sdf : f32, t : f32) -> vec2f {
+  // sdf is adapted to Fable as local water depth / shore-distance proxy.
+  var pulse = fract(sdf * 0.72 + t * 0.20 + fbm(pos * 0.035) * 0.055);
+  let frontPow = pow(pulse, 64.0);
+  let frontStep = clamp((pulse - 0.95) * 20.0, 0.0, 1.0);
+  let waveFront = max(frontPow, frontStep);
+  let waveBack = pow(1.0 - pulse, 8.0);
+  let waveHeight = max(waveFront, waveBack);
+  let fade = 1.0 - smoothstep(0.60, 0.82, sdf);
+  let foamBlob = foamProcessBlob(pos, t);
+  let waveFoam = max(0.0, waveHeight * 1.5 - 1.0 + foamBlob) * fade;
+  return vec2f(waveFoam, waveHeight * fade);
+}
