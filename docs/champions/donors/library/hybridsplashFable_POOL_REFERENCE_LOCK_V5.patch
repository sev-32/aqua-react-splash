+// POOL REFERENCE OPTICAL LOCK — equation anchors ported from the working
+// WaterPRO pool reference. No Beer fog/body-color substitute is permitted here.
+const IOR_AIR : f32 = 1.0;
+const IOR_WATER : f32 = 1.333;
+const ETA_AIR_TO_WATER : f32 = IOR_AIR / IOR_WATER;
+const ETA_WATER_TO_AIR : f32 = IOR_WATER / IOR_AIR;
+const abovewaterColor : vec3f = vec3f(0.25, 1.0, 1.25);
+const underwaterColor : vec3f = vec3f(0.4, 0.9, 1.0);
+
+fn propoolSafeY(y : f32) -> f32 {
+  // Preserve the sign of the pool equation denominator. V4 used abs(y), which
+  // changes the receiver projection direction and can misalign caustics.
+  if (abs(y) < 0.045) { return select(-0.045, 0.045, y >= 0.0); }
+  return y;
+}
+fn propoolUvFromDomain(xz : vec2f, domain : vec2f) -> vec2f {
+  return clamp(xz / max(domain, vec2f(0.001)) + vec2f(0.5), vec2f(0.001), vec2f(0.999));
+}
+fn propoolCausticReceiverUv(point : vec3f, refractedLight : vec3f, domain : vec2f) -> vec2f {
+  // Pool reference: poolUv(0.75 * (point.xz - point.y * refractedLight.xz / refractedLight.y))
+  let receiver = 0.75 * (point.xz - point.y * refractedLight.xz / propoolSafeY(refractedLight.y));
+  return propoolUvFromDomain(receiver, domain);
+}
+fn propoolFresnelAbove(normal : vec3f, incomingRay : vec3f) -> f32 {
+  // Pool waterAboveFragmentShader equation.
+  return mix(0.25, 1.0, pow(clamp(1.0 - dot(normal, -incomingRay), 0.0, 1.0), 3.0));
+}
+fn propoolFresnelBelow(normal : vec3f, incomingRay : vec3f) -> f32 {
+  // Pool waterBelowFragmentShader equation.
+  return mix(0.5, 1.0, pow(clamp(1.0 - dot(normal, -incomingRay), 0.0, 1.0), 3.0));
+}
+fn propoolNormalizedPointScale(point : vec3f, domain : vec2f, depth : f32) -> f32 {
+  // Pool getWallColor: scale = 0.5; scale /= length(point). Fable must normalize
+  // metres into the pool's [-1,1] receiver coordinates before applying that law.
+  let halfDomain = max(domain * 0.5, vec2f(0.001));
+  let q = vec3f(point.x / halfDomain.x, point.y / max(depth, 0.1), point.z / halfDomain.y);
+  return clamp(0.5 / max(length(q), 0.35), 0.18, 1.45);
+}
